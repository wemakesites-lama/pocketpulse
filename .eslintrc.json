{
  "overrides": [
    {
      "files": ["packages/core/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["next/*", "next", "react-dom*", "*/components/*"]
          }
        ],
        "no-restricted-globals": [
          "error",
          "window",
          "document",
          "localStorage",
          "navigator"
        ]
      }
    }
  ]
}
