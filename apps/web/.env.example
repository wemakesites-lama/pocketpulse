# GroqCloud — open-weight inference. Never prefix any of these NEXT_PUBLIC_.
# lib/groq.ts begins with `import "server-only"` so a stray client import fails the build.

GROQ_API_KEY=

# REQUIRED submission item: name the exact open-weight PRODUCTION model.
# Confirm the ID from the live endpoint before committing:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY" | jq '.data[].id'
# Pick a PRODUCTION model (not preview). Recommended default: llama-3.3-70b-versatile
GROQ_MODEL=

GROQ_BASE_URL=https://api.groq.com/openai/v1

# OPTIONAL: Whisper speech-to-text model for the "Speak a receipt" feature.
# Defaults to whisper-large-v3-turbo when unset. Use whisper-large-v3 for best accuracy.
GROQ_STT_MODEL=
